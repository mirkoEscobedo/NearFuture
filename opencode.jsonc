{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "computer_use": {
      "type": "local",
      "command": ["node", "./tools/computer-use-mcp/node_modules/@zavora-ai/computer-use-mcp/dist/server.js"],
      "cwd": ".",
      "enabled": true,
      "timeout": 20000,
      "environment": {
        "COMPUTER_USE_PROFILE": "core",
        "COMPUTER_USE_ACTIVE_PROFILE": "core",
        "COMPUTER_USE_AUDIT_LOG": "./.tmp/starsector-proxy/computer-use-audit.jsonl"
      }
    }
  },
  "permission": { "computer_use_*": "deny" }
}
