{
  "schema_version": 1,
  "id": "headless-foundation-v1",
  "description": "Synthetic headless foundation; no game integration or persistent writer activation",
  "platforms": ["ubuntu-latest", "windows-latest"],
  "required_jobs": ["public-build", "public-rust", "windows-interop", "release-build", "profile-smoke", "operator-public"],
  "required_check": "headless-qualification",
  "accepted_paths": ["build-identity", "synthetic-contracts", "java-rust-interop", "linux-sync-fault-recovery", "private-storage-diagnostics", "proxy-observation-parser", "membership-signing-key-rotation", "performance-report-consistency", "replica-budget-contracts", "read-only-operator-component", "systempackage-data-contracts"],
  "enabled_capabilities": ["build-identity"],
  "disabled_capabilities": ["game-lifecycle", "local-shadow", "native-writer", "peer-runtime", "chat-runtime", "managed-upgrade"],
  "persistence": {
    "writes_enabled": false,
    "schema": null,
    "provider": null,
    "writer": null,
    "roots": {"development": ".tmp/data/development", "test": ".tmp/data/test", "release": "runtime-private/data/release"}
  },
  "optional_checks": ["licensed-game-compile", "native-game-observation"]
}
